HOST=0.0.0.0
PORT=5001
DATABASE_PATH=data/editnova.db
STORAGE_PATH=data/uploads
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:8080,http://localhost:5001
LOG_LEVEL=INFO

# Generate a password hash with the backend _password_hash helper or a one-off
# Python command before setting these values in the deployment environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
TOKEN_SECRET=

# Required to use premium upgrades and protected endpoints. Generate a random
# value of at least 32 bytes and provide it through the deployment secret store.

# Optional provider integrations. The API returns a clear configuration error
# when these are absent; keys must never be placed in Flutter source code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LIBRETRANSLATE_URL=
OCR_SPACE_API_KEY=
OCR_SPACE_URL=https://api.ocr.space/parse/image
OCR_LANGUAGE=eng